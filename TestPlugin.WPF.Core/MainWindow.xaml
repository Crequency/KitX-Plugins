<Window x:Class="TestPlugin.WPF.Core.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TestPlugin.WPF.Core"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="TestPlugin.WPF.Core - MainWindow"
        Background="#FF3873D9"
        SizeToContent="WidthAndHeight"
        mc:Ignorable="d">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Margin="200,100,200,20"
                       HorizontalAlignment="Center"
                       FontSize="36"
                       Foreground="White"
                       Text="Hello KitX!"/>

            <!-- Trigger Test Section -->
            <StackPanel HorizontalAlignment="Center" Margin="0,20,0,100">
                <TextBlock Text="Trigger Test"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBox Name="TriggerInputBox"
                         Width="250"
                         Height="30"
                         Margin="0,0,0,10"
                         Text=""/>
                <Button Name="FireTriggerButton"
                        Content="Fire Trigger"
                        Width="250"
                        Height="35"
                        Click="OnFireTrigger"
                        FontSize="14"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
